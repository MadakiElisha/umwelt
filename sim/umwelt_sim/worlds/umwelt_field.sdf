<?xml version="1.0" encoding="UTF-8"?>
<!--
  A small field with obstacles for building occupancy beliefs.

  The world name must match PX4_GZ_WORLD, since PX4 uses it to find the
  world's services. The system plugins mirror PX4's default world so that
  the IMU, barometer, magnetometer and GNSS sensors on the vehicle work.
-->
<sdf version="1.9">
  <world name="umwelt_field">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-air-speed-system" name="gz::sim::systems::AirSpeed"/>
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!--
      Same location as PX4's default world. The magnetic_field above is the
      field at this location, and PX4 checks the simulated magnetometer
      against its world magnetic model for wherever GNSS says it is. Moving
      the world elsewhere without changing magnetic_field makes the EKF reject
      the heading ("Yaw estimate error") and the vehicle will not arm.
    -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material>
            <ambient>0.45 0.5 0.35 1</ambient>
            <diffuse>0.45 0.5 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Obstacles. Gazebo's world frame is ENU (x east, y north), and the vehicle
      spawns at the origin, so these coordinates are the same as the umwelt
      world frame the belief node publishes in.
    -->

    <!-- A wall 12 m east, 10 m long, 3 m high. -->
    <model name="wall_east">
      <static>true</static>
      <pose>12 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 10 3</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.4 10 3</size></box></geometry>
          <material><ambient>0.6 0.55 0.5 1</ambient><diffuse>0.6 0.55 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- A small building north-east. -->
    <model name="shed">
      <static>true</static>
      <pose>8 9 2 0 0 0.4</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>4 6 4</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>4 6 4</size></box></geometry>
          <material><ambient>0.5 0.3 0.25 1</ambient><diffuse>0.5 0.3 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Three poles south-east, like masts or trees. -->
    <model name="pole_1">
      <static>true</static>
      <pose>6 -5 2.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.3</radius><length>5</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.3</radius><length>5</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pole_2">
      <static>true</static>
      <pose>9 -7 2.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.3</radius><length>5</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.3</radius><length>5</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pole_3">
      <static>true</static>
      <pose>4 -9 2.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.3</radius><length>5</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.3</radius><length>5</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- A low crate to the west, 1 m tall. -->
    <model name="crate">
      <static>true</static>
      <pose>-6 2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1 1 1</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>1 1 1</size></box></geometry>
          <material><ambient>0.55 0.45 0.2 1</ambient><diffuse>0.55 0.45 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
